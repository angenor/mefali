  "query": "SELECT l.devis_part_coursier, l.devis_distance_m, l.devis_degraded,\n                      l.devis_composantes,\n                      z.nom AS \"zone_nom!\"\n               FROM commandes.livraison l\n               JOIN commandes.commande c ON c.id = l.commande_id\n               JOIN zones.zone z ON z.id = c.zone_id\n               WHERE l.commande_id = $1",
