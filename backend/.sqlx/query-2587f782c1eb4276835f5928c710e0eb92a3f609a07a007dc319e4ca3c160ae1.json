{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id AS commande_id, c.zone_id, c.essais_code,\n                      c.code_bloque_le AS \"bloque_le!\",\n                      l.id AS \"livraison_id?\", l.coursier_id\n               FROM commandes.commande c\n               LEFT JOIN commandes.livraison l ON l.commande_id = c.id\n               WHERE c.code_bloque_le IS NOT NULL\n                 AND (c.code_debloque_le IS NULL OR c.code_debloque_le < c.code_bloque_le)\n                 AND ($1::uuid IS NULL OR c.zone_id = $1)\n               ORDER BY c.code_bloque_le ASC",
