<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Toute la valeur de l'app passe par l'API (OTP, /config, dossier) : sans
         INTERNET elle ne fait rien. Flutter ne la déclare que dans src/debug et
         src/profile (l'outillage en a besoin pour le hot reload) — une RELEASE
         partirait donc sans réseau, et échouerait dès l'écran du téléphone. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cycle QRC (006) — scan de collecte. `mobile_scanner` ouvre la caméra EN
         PROPRE (ML Kit / CameraX), contrairement à `image_picker` qui délègue à
         l'app Appareil photo : il FAUT donc déclarer CAMERA, et
         `permission_handler` la demande au runtime avant le premier scan. La
         géo-proximité anti-fraude (< 100 m) exige la position fine :
         `geolocator` lit ACCESS_FINE_LOCATION, demandée au runtime elle aussi.
         (image_picker, lui, n'a toujours pas besoin de CAMERA — il délègue ;
         mais la déclaration ci-dessous vaut désormais pour le scanner.) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- RECORD_AUDIO n'est pas listée mais EST dans l'apk : le manifest de
         record_android la déclare et le merger la fusionne ; le plugin `record`
         la demande au runtime (repère vocal). La redéclarer ici ne changerait
         rien à l'apk. -->

    <!-- Cycle CRS (010) — service continu, US7 (research R12).
         FOREGROUND_SERVICE, WAKE_LOCK, POST_NOTIFICATIONS et
         RECEIVE_BOOT_COMPLETED arrivent par le manifest de
         `flutter_foreground_task` (le merger les fusionne). Ce qui manque et
         qu'Android 14+ exige, c'est la permission qui CORRESPOND au type de
         service déclaré ci-dessous : sans elle, le démarrage lève une
         SecurityException à la première mise en ligne. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Cycle CRS (010) — le service qui garde l'app vivante écran éteint
             tant que Yao est en ligne (FR-111 à FR-115).

             Type `location`, et pas `dataSync` : c'est bien de la position que
             ce service publie, et `dataSync` est plafonné à 6 h par 24 h depuis
             Android 15 — une journée de coursier le dépasse. Le nom de classe
             est imposé par le plugin, ne pas le renommer.

             Pas de `android:stopWithTask="true"` : le service DOIT survivre à
             la fermeture de la tâche, sinon balayer l'app depuis les récentes
             sortirait Yao du pool sans qu'il l'ait décidé. C'est la mise hors
             ligne qui l'arrête, jamais le système d'exploitation seul. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
